generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  label       String
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String
  passwordHash        String
  roleId              String?
  role                Role?          @relation(fields: [roleId], references: [id])
  employee            Employee?
  activityLogs        ActivityLog[]
  uploadedDesignFiles DesignFile[]   @relation("DesignFileUploader")
  notifications       Notification[]
  leadStatusChanges  LeadStatusHistory[] @relation("LeadStatusChangedBy")
  orderPayments      OrderPayment[] @relation("OrderPaymentRecordedBy")
  orderCosts         OrderDirectCost[] @relation("OrderCostRecordedBy")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Employee {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id])
  fullName          String
  position          String
  department        String?
  phone             String?
  isActive          Boolean      @default(true)
  managerId         String?
  manager           Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates      Employee[]   @relation("EmployeeManager")
  salesPlans        SalesPlan[]
  leadAssignments   Lead[]
  orderAssignments  Order[]
  attributedOrders  Order[]        @relation("OrderSalesAttribution")
  designAssignments DesignTask[] @relation("DesignTaskDesigner")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  whatsapp  String?
  instagram String?
  city      String?
  company   String?
  source    String?
  status    String   @default("NEW")
  notes     String?
  leads     Lead[]
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id         String    @id @default(cuid())
  title      String
  source     String?
  status     String    @default("NEW")
  value      Float     @default(0)
  reasonLost String?
  notes      String?
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])
  managerId  String?
  manager    Employee? @relation(fields: [managerId], references: [id])
  statusHistory LeadStatusHistory[]
  orders     Order[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model LeadStatusHistory {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById String?
  changedBy   User?    @relation("LeadStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())

  @@index([leadId, changedAt])
  @@index([toStatus, changedAt])
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique
  status        String      @default("NEW")
  total         Float       @default(0)
  discount      Float       @default(0)
  deposit       Float       @default(0)
  paymentStatus String      @default("PENDING")
  currency      String?
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id])
  managerId     String?
  manager       Employee?   @relation(fields: [managerId], references: [id])
  attributedSalesEmployeeId String?
  attributedSalesEmployee Employee? @relation("OrderSalesAttribution", fields: [attributedSalesEmployeeId], references: [id], onDelete: SetNull)
  attributedSalesName String?
  attributedSalesEmail String?
  items         OrderItem[]
  shipments     Shipment[]
  designTask    DesignTask?
  payments      OrderPayment[]
  directCosts   OrderDirectCost[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([currency, createdAt])
  @@index([attributedSalesEmployeeId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productName String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  model       String?
  color       String?
  strap       String?
  engraving   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DesignTask {
  id                 String       @id @default(cuid())
  orderId            String       @unique
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status             String       @default("NEW")
  revisionCount      Int          @default(0)
  deadline           DateTime?
  notes              String?
  assignedDesignerId String?
  assignedDesigner   Employee?    @relation("DesignTaskDesigner", fields: [assignedDesignerId], references: [id], onDelete: SetNull)
  files              DesignFile[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model DesignFile {
  id           String     @id @default(cuid())
  taskId       String
  task         DesignTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  storageKey   String     @unique
  mimeType     String
  size         Int
  version      Int
  uploadedById String?
  uploadedBy   User?      @relation("DesignFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([taskId, version])
}

model OrderPayment {
  id           String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("KZT")
  occurredAt   DateTime
  reference    String?
  note         String?
  recordedById String?
  recordedBy   User?    @relation("OrderPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([orderId, occurredAt])
  @@index([kind, occurredAt])
}

model OrderDirectCost {
  id           String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("KZT")
  incurredAt   DateTime
  description  String
  recordedById String?
  recordedBy   User?    @relation("OrderCostRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([orderId, incurredAt])
  @@index([category, incurredAt])
}

model InventoryItem {
  id           String              @id @default(cuid())
  sku          String              @unique
  name         String
  stock        Int                 @default(0)
  reorderLevel Int                 @default(0)
  unitPrice    Float               @default(0)
  description  String?
  movements    InventoryMovement[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model InventoryMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  type      String
  quantity  Int
  reason    String
  createdAt DateTime      @default(now())
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  trackingNumber String?
  courierName    String?
  status         String    @default("PREPARING")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SalesPlan {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  month        String
  targetAmount Float    @default(0)
  actualAmount Float    @default(0)
  bonusPercent Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, month])
}

model KpiRule {
  id           String   @id @default(cuid())
  name         String
  minPercent   Float    @default(0)
  maxPercent   Float    @default(0)
  bonusPercent Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
